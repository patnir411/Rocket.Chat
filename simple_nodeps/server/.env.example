# Server Configuration
PORT=3000
NODE_ENV=development
ROOT_URL=http://localhost:3000

# Database Configuration
DATABASE_TYPE=sqlite
DATABASE_PATH=./chat.db
# For PostgreSQL, use DATABASE_URL instead:
# DATABASE_URL=postgresql://user:password@localhost:5432/simplchat

# Security
JWT_SECRET=change-this-to-a-random-secret-key-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain

# Features
ENABLE_REGISTRATION=true
REQUIRE_EMAIL_VERIFICATION=false
MAX_ROOMS_PER_USER=100
MAX_MESSAGES_PER_REQUEST=50

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5

# WebSocket
WS_PING_INTERVAL=30000
WS_PING_TIMEOUT=5000

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=*
